# UvendNuxt local / container env
# Copy to `.env` and fill with DEV values from Jared (out of band).
# Never commit `.env`.

# Process
HOST=0.0.0.0
PORT=3002
NODE_ENV=development

# --- RUNTIME_KEYS (nuxt.config.ts / server/plugins/runtime-config.ts) ---
# Injected at runtime via globalThis.__NUXT_RUNTIME__. Empty string = unset.

# AdminSystem API (DEV)
API_URL=https://admin-api.dev.example/api

# Vend / meter API (DEV) / 
VEND_URL=https://vend-api.dev.example/api

# Wallet API (optional for admin wallet pages)
WALLET_API_URL=https://wallet-api.dev.example

# Statement / meter activity API (DEV) — keep on statement-api for now
STATEMENT_API=https://statement-api.dev.example
STATEMENT_SUMMARISED_PATH=/statement/GetDBMeterActivitySummarised

# Reporting
JSREPORT_URL=https://report.dev.example/api/report

# Mpesa (leave empty to hide Mpesa nav)
MPESA_URL=

# Basic auth for AdminSystem (base64 of "user:password") — treat as secret
ADMIN_AUTH=

# Vend terminal / operator identifiers (non-secret labels)
VEND_TerminalID=
VEND_OperatorID=

# Branding (optional; empty uses app defaults)
APP_LOGO=
APP_BG_1=
APP_BG_2=
APP_BG_3=
APP_FONT_COLOR_1=
APP_FONT_COLOR_2=
APP_FONT_COLOR_3=

# Customer directory API (DEV)
CUSTOMER_API=https://customer-api.dev.example

# Page tree: leave empty for default `pages/` (admin + my + wallet routes).
# Set to `wallet` only when building/running the wallet-only app (`pages/wallet`).
# APP_ENV is resolved at BUILD time for pagesDir — change it, then restart `pnpm dev`.
APP_ENV=

# Currency display
APP_CURRENCY=ZAR
CURRENCY_CODE=R

# Feature flags
AEON_CHECK=0
METER_ACTIVITY_LOOKBACK_DAYS=90
